# Settings for the benchmark scripts. Copy this file to bench.env and edit it.
# run_experiment.sh and remote_run.sh read the file as shell variable assignments.
# Every variable is optional unless a comment says otherwise.

# --- Where the server listens (bench.py and the health check) ---
# BENCH_HOST=127.0.0.1
# BENCH_PORT=18080
# HEALTH_URL=http://127.0.0.1:18080/health
# HEALTH_WAIT_S=300

# --- Container tools ---
# CONTAINER_CLI=docker              # docker or podman
# SERVER_CONTAINER=dmx-server       # name that the launch script gives the server container
# BENCH_CONTAINER=dmx-bench         # name of the client container
# PY_IMAGE=python:3.12-slim         # image for bench.py (pin it by digest for exact repeats)
# CLIENT_FLAGS=                     # extra flags for the client container, for example --security-opt label=disable

# --- GPU ---
# GPU_ID=0                          # value for nvidia-smi -i
# RESET_GPU_CLOCKS=0                # set 1 to reset GPU clock locks after each run (default 0)
# BENCH_VRAM_CAP_MIB=6144           # guard used by summarize.py

# --- Folders on the machine that has the GPU ---
# BENCH_LAUNCH=/path/to/launch.sh   # default: ./launch.sh
# BENCH_RUNS_DIR=/path/to/runs      # default: ./runs

# --- Settings for launch.example.sh (your own launch script can use others) ---
# IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b12004   # required by launch.example.sh
# MODEL_DIR=/path/to/models         # required by launch.example.sh
# MODEL=model.gguf                  # required by launch.example.sh
# GPU_FLAGS="--gpus all"            # how the container tool selects the GPU
# SERVER_ARGS="-ngl 999 -c 16384 -b 2048 -ub 2048 -np 3 --kv-unified --no-webui --no-slots"

# --- Used by run_experiment.sh only (set these in your shell or here) ---
# GPU_HOST=gpu-machine              # required: SSH target
# GPU_WORK_DIR=/path/on/gpu/machine # required: folder for bench/, launch.sh and runs/
