# Copy to a private file outside the repository and set DMK_ENV to its path.
DMK_HOST=gpu-host                       # ssh destination of the GPU host
DMK_BENCH_DIR=/path/to/bench            # local benchmark directory (cases, client)
DMK_REMOTE_DIR=/srv/dmk                 # work directory on the GPU host
DMK_GPU=GPU-<uuid>                      # GPU UUID for NVIDIA_VISIBLE_DEVICES
DMK_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:f25bfa096802cdf35ceb7d124816387a1e3ed5cbfc869eb242246cd29ab29352
DMK_PY_IMAGE=python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
DMK_MODELS=/srv/models                  # directory with the model files (mounted read-only)
DMK_MODEL=h2o-lightning-4b-rq-Q4_0-mix8.gguf
DMK_SHM_DIR=/dev/shm/dmk                # tmpfs directory for large temporary files
